{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": "test/integration/.*\\.spec\\.ts$",
  "transform": {
    "^.+\\.ts$": "ts-jest"
  },
  "cacheDirectory": "D:/temp/jest-cache",
  "moduleNameMapper": {
    "^@simply/types$": "<rootDir>/../../packages/types/src",
    "^@simply/config$": "<rootDir>/../../packages/config/src",
    "^@simply/validation$": "<rootDir>/../../packages/validation/src",
    "^@simply/api-contracts$": "<rootDir>/../../packages/api-contracts/src",
    "^@simply/storage$": "<rootDir>/../../packages/storage/src",
    "^@simply/db$": "<rootDir>/../../packages/db/src"
  },
  "setupFiles": ["<rootDir>/test/setup-test-db.js"],
  "testTimeout": 30000
}
