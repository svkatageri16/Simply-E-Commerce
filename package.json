{
  "name": "simply-ecommerce-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Production-grade multi-tenant SaaS ecommerce platform for Indian businesses",
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev-merchant.mjs --all",
    "dev:merchant": "node scripts/dev-merchant.mjs --merchant",
    "dev:admin": "node scripts/dev-merchant.mjs --admin",
    "dev:status": "node scripts/dev-merchant.mjs --status",
    "dev:stop": "node scripts/dev-merchant.mjs --stop",
    "dev:all": "node scripts/dev-merchant.mjs --all",
    "admin:seed": "node scripts/seed-admin.mjs",
    "test:admin": "node scripts/test-admin-moderation.mjs",
    "dev:check": "pnpm --filter @simply/db exec tsx ../../scripts/dev-health-check.ts",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "pnpm --filter @simply/api test",
    "test:e2e": "pnpm --filter @simply/api test:e2e",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @simply/db generate",
    "db:migrate": "pnpm --filter @simply/db migrate",
    "db:seed": "pnpm --filter @simply/db seed",
    "db:studio": "pnpm --filter @simply/db studio",
    "demo:reset": "pnpm --filter @simply/db exec tsx ../../scripts/demo-reset.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test:admin:dashboard": "node scripts/test-admin-dashboard.mjs",
    "smtp:test": "node scripts/test-smtp-health.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "playwright": "^1.63.0",
    "prettier": "^3.5.3",
    "puppeteer-core": "^25.12.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@12.8.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "@scarf/scarf",
      "core-js"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
