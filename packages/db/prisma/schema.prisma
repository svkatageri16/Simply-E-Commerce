datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Gateway mandate and agreed price remain separate from paid access.
model AutoPayMandate {
  id                     String   @id @default(uuid())
  tenantId               String   @map("tenant_id")
  planId                 String   @map("plan_id")
  providerSubscriptionId String   @unique @map("provider_subscription_id")
  providerPlanId         String   @map("provider_plan_id")
  quote                  Json
  createdAt              DateTime @default(now()) @map("created_at")
  tenant                 Tenant   @relation(fields: [tenantId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  plan                   Plan     @relation(fields: [planId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([tenantId])
  @@map("autopay_mandates")
}

// ==============================================================================
// ENUMS
// ==============================================================================

enum UserRole {
  PLATFORM_ADMIN
  SELLER_OWNER
  SELLER_STAFF
}

enum CredentialType {
  PIN
  PASSKEY
  BIOMETRIC
}

enum OtpPurpose {
  EMAIL_VERIFICATION
  REGISTRATION
  LOGIN
  RECOVERY
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StoreStatus {
  DRAFT
  PRIVATE_PREVIEW
  LIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  EXPIRED
}

enum ProductMode {
  SELL_ONLINE
  ENQUIRY_ONLY
  SELL_AND_ENQUIRY
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ACTIVE
  ARCHIVED
}

enum VariantStatus {
  ACTIVE
  INACTIVE
  DISCONTINUED
}

enum OptionType {
  COLOUR
  SIZE
  MATERIAL
  STORAGE
  PACK_SIZE
  CUSTOM
}

enum InventoryMovementType {
  INITIAL_STOCK
  MANUAL_ADJUSTMENT
  ORDER_RESERVATION
  ORDER_FULFILLMENT
  ORDER_CANCELLATION
  RETURN_RESTOCK
}

enum OrderStatus {
  NEW
  CONFIRMED
  ACCEPTED
  READY
  DISPATCHED
  COMPLETED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  READY_TO_SHIP
  SHIPPED
  DELIVERED
  RETURN_REQUESTED
  RETURNED
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  MANIFESTED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RTO
}

enum ThemeKey {
  ATELIER
  PULSE
  HARVEST
  FOUNDRY
  HABITAT
  LOCAL
  FEAST
  AURA
  NOIR
  VISTA
}

enum FulfillmentMode {
  DELIVERY
  PICKUP
  DELIVERY_AND_PICKUP
}

enum SectionType {
  HERO
  CATEGORIES
  FEATURED_COLLECTION
  NEW_ARRIVALS
  BESTSELLERS
  STORY
  TESTIMONIALS
  PHYSICAL_STORE
  CUSTOM_BANNER
  CONTACT
}

enum EnquiryStatus {
  NEW
  IN_REVIEW
  QUOTATION_SENT
  ACCEPTED
  REJECTED
  CLOSED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ConsentPurpose {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  MARKETING_COMMUNICATION
  ORDER_TRACKING
}

enum DataSubjectRequestType {
  DATA_EXPORT
  DATA_ERASURE
  CONSENT_WITHDRAWAL
  DATA_RECTIFICATION
}

enum DataSubjectRequestStatus {
  PENDING
  IN_REVIEW
  FULFILLED
  REJECTED
}

enum PaymentProviderType {
  MOCK
  RAZORPAY
}

enum PaymentPurpose {
  PLATFORM_SUBSCRIPTION
  MERCHANT_ORDER
}

enum ShippingProviderType {
  MOCK
  SHIPROCKET
}

// ==============================================================================
// AUTH & TENANCY
// ==============================================================================

model User {
  id             String             @id @default(uuid())
  phone          String             @unique
  email          String?            @unique
  fullName       String
  emailVerifiedAt DateTime? @map("email_verified_at")
  role           UserRole           @default(SELLER_OWNER)
  isSuperAdmin   Boolean            @default(false)
  isActive       Boolean            @default(true)
  preferredLocale String            @default("en-IN") @map("preferred_locale")
  adminPermissions Json?            @default("[]") @map("admin_permissions")
  mustChangePassword Boolean        @default(false) @map("must_change_password")
  isDeactivated  Boolean            @default(false) @map("is_deactivated")
  activatedAt    DateTime?          @map("activated_at")
  lastLoginAt    DateTime?          @map("last_login_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  deletedAt      DateTime?          @map("deleted_at")

  memberships    TenantMembership[]
  sessions       Session[]
  refreshTokens  RefreshToken[]
  credentials    SellerCredential[]
  devices        Device[]
  otpChallenges  OtpChallenge[]

  @@map("users")
}

model SellerCredential {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  credentialType    CredentialType @default(PIN) @map("credential_type")
  pinHash           String?        @map("pin_hash")
  publicKey         String?        @map("public_key")
  failedPinAttempts Int            @default(0) @map("failed_pin_attempts")
  lockedUntil       DateTime?      @map("locked_until")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, credentialType])
  @@map("seller_credentials")
}

model OtpChallenge {
  id          String      @id @default(uuid())
  userId      String?     @map("user_id")
  email       String?
  deliveredAt DateTime? @map("delivered_at")
  consumedAt  DateTime? @map("consumed_at")
  phone       String
  purpose     OtpPurpose  @default(REGISTRATION)
  codeHash    String      @map("code_hash")
  attempts    Int         @default(0)
  maxAttempts Int         @default(5) @map("max_attempts")
  isVerified  Boolean     @default(false) @map("is_verified")
  expiresAt   DateTime    @map("expires_at")
  verifiedAt  DateTime?   @map("verified_at")
  createdAt   DateTime    @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phone, purpose, isVerified, expiresAt])
  @@index([email, purpose, createdAt])
  @@index([phone, purpose, createdAt])
  @@index([createdAt])
  @@map("otp_challenges")
}

model OtpRequest {
  id          String    @id @default(uuid())
  phone       String
  codeHash    String    @map("code_hash")
  attempts    Int       @default(0)
  maxAttempts Int       @default(5) @map("max_attempts")
  isVerified  Boolean   @default(false) @map("is_verified")
  expiresAt   DateTime  @map("expires_at")
  verifiedAt  DateTime? @map("verified_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([phone, isVerified, expiresAt])
  @@map("otp_requests")
}

model Device {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  deviceFingerprint String    @map("device_fingerprint")
  deviceName        String?   @map("device_name")
  userAgent         String?   @map("user_agent")
  lastIp            String?   @map("last_ip")
  isTrusted         Boolean   @default(false) @map("is_trusted")
  lastSeenAt        DateTime  @default(now()) @map("last_seen_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@unique([userId, deviceFingerprint])
  @@map("devices")
}

model Session {
  id         String         @id @default(uuid())
  userId     String         @map("user_id")
  tenantId   String?        @map("tenant_id")
  storeId    String?        @map("store_id")
  deviceId   String?        @map("device_id")
  tokenHash  String         @unique @map("token_hash")
  ipAddress  String?        @map("ip_address")
  userAgent  String?        @map("user_agent")
  isRevoked  Boolean        @default(false) @map("is_revoked")
  expiresAt  DateTime       @map("expires_at")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  device        Device?        @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  refreshTokens RefreshToken[]

  @@index([userId, isRevoked, expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  sessionId         String    @map("session_id")
  tokenHash         String    @unique @map("token_hash")
  deviceName        String?   @map("device_name")
  ipAddress         String?   @map("ip_address")
  isRevoked         Boolean   @default(false) @map("is_revoked")
  expiresAt         DateTime  @map("expires_at")
  replacedByTokenId String?   @map("replaced_by_token_id")
  createdAt         DateTime  @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([tokenHash, isRevoked])
  @@map("refresh_tokens")
}

model Tenant {
  autoPayMandates AutoPayMandate[]
  id        String       @id @default(uuid())
  name      String
  slug      String       @unique
  status    TenantStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  deletedAt DateTime?    @map("deleted_at")

  memberships           TenantMembership[]
  stores                Store[]
  subscriptions         Subscription[]
  invoices              SubscriptionInvoice[]
  paymentAccounts       MerchantPaymentAccount[]
  shippingAccounts      MerchantShippingAccount[]
  shippingProfiles      ShippingProfile[]
  categories            Category[]
  products              Product[]
  customers             Customer[]
  orders                Order[]
  enquiries             Enquiry[]
  auditLogs             AuditLog[]
  dataSubjectRequests   DataSubjectRequest[]
  mediaAssets               MediaAsset[]
  businessType              String?                 @map("business_type") // SOLE_PROPRIETORSHIP, PARTNERSHIP, LLP, PRIVATE_LIMITED, PUBLIC_LIMITED, OTHER
  gstRegistered             Boolean?                @default(false) @map("gst_registered")
  gstin                     String?
  panNumber                 String?                 @map("pan_number")
  udyamNumber               String?                 @map("udyam_number")
  businessVerificationStatus String                 @default("INCOMPLETE") @map("business_verification_status") // INCOMPLETE, PENDING_REVIEW, VERIFIED, NEEDS_CHANGES
  documents                 MerchantDocument[]
  billingName               String?                 @map("billing_name")
  billingAddress            String?                 @map("billing_address")
  billingState              String?                 @map("billing_state")
  billingPincode            String?                 @map("billing_pincode")
  billingEmail              String?                 @map("billing_email")

  @@map("tenants")
}

model TenantMembership {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  role      UserRole @default(SELLER_STAFF)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@map("tenant_memberships")
}

model Store {
  id                   String      @id @default(uuid())
  tenantId             String      @map("tenant_id")
  name                 String
  slug                 String      @unique
  description          String?
  status               StoreStatus @default(DRAFT)
  defaultCurrency      String      @default("INR") @map("default_currency")
  timezone             String      @default("Asia/Kolkata")
  isPubliclyAccessible Boolean     @default(false) @map("is_publicly_accessible")
  previewSecret        String      @default(uuid()) @map("preview_secret")
  storefrontDefaultLocale String   @default("en-IN") @map("storefront_default_locale")
  enabledStorefrontLocales String[] @default(["en-IN", "mr-IN", "hi-IN"]) @map("enabled_storefront_locales")
  supportPhone         String?                   @map("support_phone")
  supportEmail         String?                   @map("support_email")
  whatsappNumber       String?                   @map("whatsapp_number")
  businessAddress      String?                   @map("business_address")
  mapsUrl              String?                   @map("maps_url")
  socialLinks          Json?                     @map("social_links")
  fulfillmentMode      FulfillmentMode           @default(DELIVERY) @map("fulfillment_mode")
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")
  deletedAt            DateTime?                 @map("deleted_at")

  tenant             Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branding           StoreBranding?
  themeConfigs       StoreThemeConfig[]
  themeConfiguration StoreThemeConfiguration?
  sections           StoreSection[]
  businessHours      StoreBusinessHours[]
  categories         Category[]
  products           Product[]
  productDocuments   ProductDocument[]
  customers          Customer[]
  carts              Cart[]
  orders             Order[]
  enquiries          Enquiry[]
  shippingProfiles   ShippingProfile[]
  mediaAssets        MediaAsset[]
  productReviews     ProductReview[]

  @@index([tenantId, status])
  @@index([slug, isPubliclyAccessible])
  @@map("stores")
}

model StoreBranding {
  id             String   @id @default(uuid())
  storeId        String   @unique @map("store_id")
  logoUrl        String?  @map("logo_url")
  faviconUrl     String?  @map("favicon_url")
  logoMediaId    String?  @map("logo_media_id")
  heroMediaId    String?  @map("hero_media_id")
  faviconMediaId String?  @map("favicon_media_id")
  primaryColor   String   @default("#1E40AF") @map("primary_color")
  accentColor    String   @default("#F59E0B") @map("accent_color")
  fontHeading    String   @default("Inter") @map("font_heading")
  fontBody       String   @default("Inter") @map("font_body")
  announcement   String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("store_branding")
}

model Theme {
  id          String   @id @default(uuid())
  name        String
  code        String   @unique
  isDefault   Boolean  @default(false) @map("is_default")
  configJson  Json?    @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  storeConfigs StoreThemeConfig[]

  @@map("themes")
}

model ThemeDefinition {
  id            String   @id @default(uuid())
  key           ThemeKey @unique
  name          String
  version       String   @default("1.0.0")
  description   String?
  categoryFit   String   @map("category_fit")
  defaultConfig Json     @map("default_config")
  capabilities  Json
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  storeConfigurations StoreThemeConfiguration[]

  @@map("theme_definitions")
}

model StoreThemeConfig {
  id         String   @id @default(uuid())
  storeId    String   @map("store_id")
  themeId    String   @map("theme_id")
  configJson Json     @map("config_json")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@unique([storeId, themeId])
  @@map("store_theme_configs")
}

model StoreThemeConfiguration {
  id                     String          @id @default(uuid())
  storeId                String          @unique @map("store_id")
  themeDefinitionId      String          @map("theme_definition_id")
  themeVersion           String          @default("1.0.0") @map("theme_version")
  configuration          Json
  publishedConfiguration Json?           @map("published_configuration")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  themeDefinition ThemeDefinition @relation(fields: [themeDefinitionId], references: [id], onDelete: Restrict)

  @@map("store_theme_configurations")
}

model StoreSection {
  id            String      @id @default(uuid())
  storeId       String      @map("store_id")
  type          SectionType @default(HERO)
  sectionType   String      @default("hero") @map("section_type")
  title         String?
  position      Int         @default(0)
  sortOrder     Int         @default(0) @map("sort_order")
  enabled       Boolean     @default(true)
  isEnabled     Boolean     @default(true) @map("is_enabled")
  configuration Json?       @map("configuration")
  configJson    Json?       @map("config_json")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId, position])
  @@index([storeId, sortOrder])
  @@map("store_sections")
}

model StoreBusinessHours {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  dayOfWeek Int      @map("day_of_week") // 0 = Sunday, 1 = Monday, ... 6 = Saturday
  openTime  String   @map("open_time") // e.g. "09:00"
  closeTime String   @map("close_time") // e.g. "21:00"
  isClosed  Boolean  @default(false) @map("is_closed")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, dayOfWeek])
  @@index([storeId])
  @@map("store_business_hours")
}

model MediaAsset {
  id              String            @id @default(uuid())
  tenantId        String            @map("tenant_id")
  storeId         String?           @map("store_id")
  storageProvider String            @default("LOCAL") @map("storage_provider") // LOCAL, CLOUDFLARE_R2, S3
  storageKey      String            @unique @map("storage_key")
  publicUrl       String            @map("public_url")
  fileName        String            @map("file_name")
  mimeType        String            @map("mime_type")
  sizeBytes       Int               @map("size_bytes")
  checksum        String?
  width           Int?
  height          Int?
  altText         String?           @map("alt_text")
  focalPointX     Float?            @default(0.5) @map("focal_point_x")
  focalPointY     Float?            @default(0.5) @map("focal_point_y")
  metadata        Json?
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  deletedAt       DateTime?         @map("deleted_at")

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store?            @relation(fields: [storeId], references: [id], onDelete: SetNull)
  productMedia     ProductMedia[]
  productDocuments ProductDocument[]

  @@index([tenantId, createdAt])
  @@index([storeId])
  @@map("media_assets")
}

// ==============================================================================
// SUBSCRIPTION SYSTEM
// ==============================================================================

model Plan {
  autoPayMandates AutoPayMandate[]
  id                  String   @id @default(uuid())
  code                String   @unique
  name                String
  description         String?
  pricePaise          Int      @map("price_paise") // 0 for free/trial, e.g. 99900 for ₹999
  gstBasisPoints      Int      @default(1800) @map("gst_basis_points")
  status              String   @default("ACTIVE") // ACTIVE, COMING_SOON, CONTACT_SALES, INACTIVE
  displayOrder        Int      @default(0) @map("display_order")
  badge               String?
  isPurchasable       Boolean  @default(true) @map("is_purchasable")
  features            Json?
  billingCycle        String   @default("MONTHLY") @map("billing_cycle") // MONTHLY, YEARLY
  maxProducts         Int      @default(50) @map("max_products")
  maxStaff            Int      @default(2) @map("max_staff")
  maxStorageMb        Int      @default(1024) @map("max_storage_mb")
  customDomainAllowed Boolean  @default(false) @map("custom_domain_allowed")
  isPublic            Boolean  @default(true) @map("is_public")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]
  highlights    PlanHighlight[]

  @@map("plans")
}

model PlanHighlight {
  id        String   @id @default(uuid())
  planId    String   @map("plan_id")
  text      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
  @@map("plan_highlights")
}

model Subscription {
  id                 String             @id @default(uuid())
  tenantId           String             @map("tenant_id")
  planId             String             @map("plan_id")
  status             SubscriptionStatus @default(TRIALING)
  currentPeriodStart DateTime           @map("current_period_start")
  currentPeriodEnd   DateTime           @map("current_period_end")
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  trialEndsAt        DateTime?          @map("trial_ends_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  tenant   Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan                  @relation(fields: [planId], references: [id], onDelete: Restrict)
  events   SubscriptionEvent[]
  invoices SubscriptionInvoice[]

  @@index([tenantId, status])
  @@map("subscriptions")
}

model SubscriptionEvent {
  id             String   @id @default(uuid())
  subscriptionId String   @map("subscription_id")
  eventType      String   @map("event_type") // ACTIVATED, RENEWED, EXPIRED, CANCELLED, OVERRIDDEN
  metadata       Json?
  createdAt      DateTime @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, createdAt])
  @@map("subscription_events")
}

model SubscriptionInvoice {
  baseAmountPaise Int?     @map("base_amount_paise")
  taxPaise        Int?     @map("tax_paise")
  gstBasisPoints  Int?     @map("gst_basis_points")
  snapshot        Json?
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  subscriptionId String    @map("subscription_id")
  invoiceNumber  String    @unique @map("invoice_number")
  amountPaise    Int       @map("amount_paise")
  currency       String    @default("INR")
  status         String    @default("PAID") // PAID, PENDING, VOID
  invoicePdfUrl  String?   @map("invoice_pdf_url")
  paidAt         DateTime? @map("paid_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  tenant       Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payments     SubscriptionPayment[]

  @@map("subscription_invoices")
}

model SubscriptionPayment {
  id                String   @id @default(uuid())
  invoiceId         String   @map("invoice_id")
  paymentMethod     String   @default("RAZORPAY") @map("payment_method")
  providerPaymentId String?  @map("provider_payment_id")
  amountPaise       Int      @map("amount_paise")
  status            String   @default("SUCCESS")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")

  invoice SubscriptionInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("subscription_payments")
}

// ==============================================================================
// CATALOGUE & VARIANTS
// ==============================================================================

model Category {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  storeId      String   @map("store_id")
  name         String
  slug         String
  description  String?
  parentId     String?  @map("parent_id")
  mediaAssetId String?  @map("media_asset_id")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant   Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([tenantId, storeId, isActive])
  @@map("categories")
}

model Product {
  id               String        @id @default(uuid())
  tenantId         String        @map("tenant_id")
  storeId          String        @map("store_id")
  categoryId       String?       @map("category_id")
  name             String
  slug             String
  description      String?
  mode             ProductMode   @default(SELL_ONLINE)
  status           ProductStatus @default(DRAFT)
  minOrderQuantity Int           @default(1) @map("min_order_quantity")
  leadTimeDays     Int?          @map("lead_time_days")
  brochureUrl      String?       @map("brochure_url")
  specifications   Json?         // Key-value specifications for B2B/industrial products
  enquiryCtaText   String?       @default("Request Quotation") @map("enquiry_cta_text")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category  Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  options    ProductOption[]
  variants   ProductVariant[]
  attributes ProductAttribute[]
  documents  ProductDocument[]
  media      ProductMedia[]
  enquiries  Enquiry[]
  orderItems OrderItem[]
  reviews    ProductReview[]
  translations ProductTranslation[]

  @@unique([storeId, slug])
  @@index([tenantId, storeId, status])
  @@index([storeId, status])
  @@index([name])
  @@map("products")
}

model ProductOption {
  id        String     @id @default(uuid())
  tenantId  String     @map("tenant_id")
  storeId   String     @map("store_id")
  productId String     @map("product_id")
  name      String     // e.g. Colour, Size, Material, Storage, Pack Size
  type      OptionType @default(CUSTOM)
  sortOrder Int        @default(0) @map("sort_order")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  product Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  values  ProductOptionValue[]

  @@unique([productId, name])
  @@index([tenantId, storeId])
  @@index([productId])
  @@map("product_options")
}

model ProductOptionValue {
  id        String   @id @default(uuid())
  optionId  String   @map("option_id")
  value     String   // e.g. "Navy Blue", "XL", "Cotton"
  colorHex  String?  @map("color_hex") // e.g. #000080
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  option        ProductOption               @relation(fields: [optionId], references: [id], onDelete: Cascade)
  variantValues ProductVariantOptionValue[]
  media         ProductMedia[]

  @@unique([optionId, value])
  @@index([optionId])
  @@map("product_option_values")
}

model ProductVariant {
  id                  String        @id @default(uuid())
  tenantId            String        @map("tenant_id")
  storeId             String        @map("store_id")
  productId           String        @map("product_id")
  sku                 String
  barcode             String?
  pricePaise          Int           @map("price_paise") // minor units e.g. 129900
  compareAtPricePaise Int?          @map("compare_at_price_paise")
  costPricePaise      Int?          @map("cost_price_paise")
  status              VariantStatus @default(ACTIVE)
  weightGrams         Int?          @map("weight_grams")
  lengthCm            Float?        @map("length_cm")
  widthCm             Float?        @map("width_cm")
  heightCm            Float?        @map("height_cm")
  sortOrder           Int           @default(0) @map("sort_order")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  deletedAt           DateTime?     @map("deleted_at")

  product      Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  optionValues ProductVariantOptionValue[]
  inventory    Inventory?
  media        ProductMedia[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@unique([storeId, sku])
  @@index([tenantId, storeId, status])
  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model ProductVariantOptionValue {
  id            String @id @default(uuid())
  variantId     String @map("variant_id")
  optionValueId String @map("option_value_id")

  variant     ProductVariant     @relation(fields: [variantId], references: [id], onDelete: Cascade)
  optionValue ProductOptionValue @relation(fields: [optionValueId], references: [id], onDelete: Cascade)

  @@unique([variantId, optionValueId])
  @@map("product_variant_option_values")
}

model ProductMedia {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  storeId      String      @map("store_id")
  productId    String      @map("product_id")
  variantId     String?             @map("variant_id") // Links variant-specific images
  optionValueId String?             @map("option_value_id") // Links colour- or option-specific images
  mediaAssetId  String?             @map("media_asset_id")
  storageKey    String              @map("storage_key")
  publicUrl     String              @map("public_url")
  filePath      String              @map("file_path")
  mimeType      String              @map("mime_type")
  sizeBytes     Int                 @map("size_bytes")
  width         Int?
  height        Int?
  altText       String?             @map("alt_text")
  sortOrder     Int                 @default(0) @map("sort_order")
  createdAt     DateTime            @default(now()) @map("created_at")

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant     ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  optionValue ProductOptionValue? @relation(fields: [optionValueId], references: [id], onDelete: SetNull)
  mediaAsset  MediaAsset?         @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([variantId])
  @@index([optionValueId])
  @@map("product_media")
}

model ProductAttribute {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String   // e.g. Material, Pressure, Shelf Life, Fabric, Voltage, Serves
  value     String   // e.g. SS316, PN40, 7 Days, Linen, 220V, 4
  type      String   @default("TEXT") // TEXT, NUMBER, BADGE, DIMENSION, BOOLEAN
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId, sortOrder])
  @@map("product_attributes")
}

model ProductDocument {
  id           String      @id @default(uuid())
  tenantId     String      @map("tenant_id")
  storeId      String      @map("store_id")
  productId    String      @map("product_id")
  mediaAssetId String?     @map("media_asset_id")
  title        String      // e.g. "Technical Datasheet", "ISO 9001 Certificate"
  docType      String      @default("DATASHEET") @map("doc_type") // BROCHURE, DATASHEET, DRAWING, MANUAL, CERTIFICATE
  fileUrl      String      @map("file_url")
  fileSizeMb   Float?      @map("file_size_mb")
  sortOrder    Int         @default(0) @map("sort_order")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: SetNull)

  @@index([productId, sortOrder])
  @@index([storeId])
  @@map("product_documents")
}

model ProductTranslation {
  id             String   @id @default(uuid())
  productId      String   @map("product_id")
  locale         String   // e.g. "mr-IN", "hi-IN"
  name           String
  description    String?
  seoTitle       String?  @map("seo_title")
  seoDescription String?  @map("seo_description")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([productId])
  @@map("product_translations")
}

// ==============================================================================
// INVENTORY & MOVEMENTS
// ==============================================================================

model Inventory {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  storeId              String   @map("store_id")
  variantId            String   @unique @map("variant_id")
  stockOnHand          Int      @default(0) @map("stock_on_hand")
  stockReserved        Int      @default(0) @map("stock_reserved")
  safetyStockThreshold Int      @default(0) @map("safety_stock_threshold")
  allowBackorder       Boolean  @default(false) @map("allow_backorder")
  updatedAt            DateTime @updatedAt @map("updated_at")

  variant   ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([tenantId, storeId])
  @@index([variantId])
  @@map("inventory")
}

model InventoryMovement {
  id            String                @id @default(uuid())
  tenantId      String                @map("tenant_id")
  storeId       String                @map("store_id")
  variantId     String                @map("variant_id")
  inventoryId   String                @map("inventory_id")
  movementType  InventoryMovementType @map("movement_type")
  quantityDelta Int                   @map("quantity_delta") // positive for additions, negative for deductions
  balanceAfter  Int                   @map("balance_after")
  referenceType String?               @map("reference_type") // ORDER, MANUAL, RETURN
  referenceId   String?               @map("reference_id")
  notes         String?
  actorId       String?               @map("actor_id")
  createdAt     DateTime              @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([tenantId, storeId])
  @@map("inventory_movements")
}

// ==============================================================================
// CUSTOMERS & GUEST CHECKOUT
// ==============================================================================

model Customer {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  storeId   String   @map("store_id")
  phone     String
  email     String?
  fullName  String   @map("full_name")
  isGuest   Boolean  @default(true) @map("is_guest")
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store     Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  addresses CustomerAddress[]
  orders    Order[]
  carts     Cart[]
  consents  ConsentRecord[]

  @@index([tenantId, storeId, phone])
  @@index([storeId, phone])
  @@map("customers")
}

model CustomerAddress {
  id           String   @id @default(uuid())
  customerId   String   @map("customer_id")
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  isDefault    Boolean  @default(false) @map("is_default")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

// ==============================================================================
// CART (GUEST-FIRST)
// ==============================================================================

model Cart {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  storeId    String    @map("store_id")
  guestToken String?   @unique @map("guest_token")
  customerId String?   @map("customer_id")
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  store    Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([tenantId, storeId])
  @@index([guestToken])
  @@map("carts")
}

model CartItem {
  id             String   @id @default(uuid())
  cartId         String   @map("cart_id")
  variantId      String   @map("variant_id")
  quantity       Int      @default(1)
  unitPricePaise Int      @map("unit_price_paise")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@map("cart_items")
}

// ==============================================================================
// ORDERS & FULFILLMENT
// ==============================================================================

model Order {
  buyerEmail        String?           @map("buyer_email")
  buyerName         String?           @map("buyer_name")
  checkoutKey       String?           @unique @map("checkout_key")
  checkoutHash      String?           @map("checkout_hash")
  id                String            @id @default(uuid())
  tenantId          String            @map("tenant_id")
  storeId           String            @map("store_id")
  customerId        String            @map("customer_id")
  orderNumber       String            @unique @map("order_number")
  status            OrderStatus       @default(NEW)
  paymentStatus     PaymentStatus     @default(PENDING) @map("payment_status")
  shipmentStatus    ShipmentStatus    @default(PENDING) @map("shipment_status")
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  fulfillmentMode   FulfillmentMode   @default(DELIVERY) @map("fulfillment_mode")
  subtotalPaise     Int               @map("subtotal_paise")
  taxPaise          Int               @default(0) @map("tax_paise")
  shippingPaise     Int               @default(0) @map("shipping_paise")
  discountPaise     Int               @default(0) @map("discount_paise")
  totalPaise        Int               @map("total_paise")
  currency          String            @default("INR")
  notes             String?
  deliveryAddress   Json              @map("delivery_address") // Snapshot of address
  paymentMethod     String?           @default("COD") @map("payment_method")
  codCollectionMethod String?         @map("cod_collection_method")
  codCollectedAt    DateTime?         @map("cod_collected_at")
  codCollectedBy    String?           @map("cod_collected_by")
  guestCheckout     Boolean           @default(true) @map("guest_checkout")
  trackingToken     String?           @unique @map("tracking_token")
  reviewToken       String?           @unique @map("review_token")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  cancelledAt       DateTime?         @map("cancelled_at")

  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  orderAddress  OrderAddress?
  items         OrderItem[]
  statusHistory OrderStatusHistory[]
  paymentOrders PaymentOrder[]
  shipments     Shipment[]
  refunds       Refund[]
  reviews       ProductReview[]

  @@index([tenantId, storeId, status])
  @@index([storeId, status])
  @@index([storeId, createdAt])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderAddress {
  id           String   @id @default(uuid())
  orderId      String   @unique @map("order_id")
  fullName     String   @map("full_name")
  phone        String
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  landmark     String?
  city         String
  state        String
  pincode      String
  country      String   @default("India")
  createdAt    DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_addresses")
}

model OrderItem {
  id              String   @id @default(uuid())
  orderId         String   @map("order_id")
  productId       String?  @map("product_id")
  variantId       String?  @map("variant_id")
  productName     String   @map("product_name") // Snapshot
  variantTitle    String   @map("variant_title") // Snapshot (e.g. "Navy / XL")
  sku             String   // Snapshot
  selectedOptions Json     @map("selected_options") // Snapshot of options
  quantity        Int
  unitPricePaise  Int      @map("unit_price_paise")
  taxPaise        Int      @default(0) @map("tax_paise")
  totalPaise      Int      @map("total_paise")
  imageUrl        String?  @map("image_url") // Snapshot of variant/colour image at order time
  createdAt       DateTime @default(now()) @map("created_at")

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  reviews ProductReview[]

  @@map("order_items")
}

model OrderStatusHistory {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  reason     String?
  actorId    String?  @map("actor_id")
  createdAt  DateTime @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

// ==============================================================================
// PAYMENTS & MULTI-MERCHANT GATEWAY
// ==============================================================================

model MerchantPaymentAccount {
  id                     String              @id @default(uuid())
  tenantId               String              @map("tenant_id")
  storeId                String              @map("store_id")
  provider               PaymentProviderType @default(MOCK)
  isEnabled              Boolean             @default(true) @map("is_enabled")
  connectionStatus       String              @default("NOT_CONNECTED") @map("connection_status") // NOT_CONNECTED, CONNECTED, PENDING_VERIFICATION
  kycStatus              String              @default("NOT_STARTED") @map("kyc_status") // NOT_STARTED, IN_REVIEW, VERIFIED, REJECTED
  keyId                  String              @map("key_id") // Merchant-specific API Key ID
  keySecretEncrypted     String              @map("key_secret_encrypted")
  webhookSecretEncrypted String?             @map("webhook_secret_encrypted")
  merchantAccountId      String?             @map("merchant_account_id")
  capabilities           Json?
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([tenantId, storeId])
  @@map("merchant_payment_accounts")
}

model PaymentOrder {
  baseAmountPaise Int?                @map("base_amount_paise")
  taxPaise        Int?                @map("tax_paise")
  gstBasisPoints  Int?                @map("gst_basis_points")
  id              String              @id @default(uuid())
  tenantId        String              @map("tenant_id")
  storeId         String              @map("store_id")
  orderId         String?             @map("order_id")
  subscriptionId  String?             @map("subscription_id")
  purpose         PaymentPurpose      @default(MERCHANT_ORDER)
  provider        PaymentProviderType @default(MOCK)
  providerOrderId String              @map("provider_order_id")
  amountPaise     Int                 @map("amount_paise")
  currency        String              @default("INR")
  status          PaymentStatus       @default(PENDING)
  idempotencyKey  String?             @unique @map("idempotency_key")
  receipt         String?
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  order        Order?               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@index([tenantId, storeId])
  @@index([providerOrderId])
  @@index([subscriptionId])
  @@map("payment_orders")
}

model PaymentTransaction {
  id                String        @id @default(uuid())
  paymentOrderId    String        @map("payment_order_id")
  providerPaymentId String        @unique @map("provider_payment_id")
  providerSignature String?       @map("provider_signature")
  status            PaymentStatus @default(PAID)
  amountPaise       Int           @map("amount_paise")
  feePaise          Int?          @map("fee_paise")
  taxPaise          Int?          @map("tax_paise")
  paymentMethod     String?       @map("payment_method") // upi, card, netbanking
  rawResponse       Json?         @map("raw_response")
  createdAt         DateTime      @default(now()) @map("created_at")

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Cascade)
  refunds      Refund[]

  @@map("payment_transactions")
}

model Refund {
  id                   String   @id @default(uuid())
  tenantId             String   @map("tenant_id")
  storeId              String   @map("store_id")
  orderId              String   @map("order_id")
  paymentTransactionId String   @map("payment_transaction_id")
  providerRefundId     String?  @unique @map("provider_refund_id")
  amountPaise          Int      @map("amount_paise")
  reason               String?
  status               String   @default("PROCESSED")
  createdAt            DateTime @default(now()) @map("created_at")

  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentTransaction PaymentTransaction @relation(fields: [paymentTransactionId], references: [id], onDelete: Restrict)

  @@index([tenantId, storeId])
  @@map("refunds")
}

model PaymentWebhookEvent {
  id          String         @id @default(uuid())
  provider    String
  purpose     PaymentPurpose @default(MERCHANT_ORDER)
  eventId     String         @unique @map("event_id")
  eventType   String         @map("event_type")
  payload     Json
  payloadHash String?        @map("payload_hash")
  status      String         @default("RECEIVED") // RECEIVED, PROCESSED, FAILED, IGNORED
  retryCount  Int            @default(0) @map("retry_count")
  isProcessed Boolean        @default(false) @map("is_processed")
  processedAt DateTime?      @map("processed_at")
  error       String?
  createdAt   DateTime       @default(now()) @map("created_at")

  @@index([provider, eventType, isProcessed])
  @@map("payment_webhook_events")
}

// ==============================================================================
// SHIPPING & LOGISTICS (SHIPROCKET ADAPTER)
// ==============================================================================

model MerchantShippingAccount {
  id                 String               @id @default(uuid())
  tenantId           String               @map("tenant_id")
  storeId            String               @map("store_id")
  provider           ShippingProviderType @default(MOCK)
  isEnabled          Boolean              @default(true) @map("is_enabled")
  apiKeyEncrypted    String               @map("api_key_encrypted")
  apiSecretEncrypted String               @map("api_secret_encrypted")
  accountId          String?              @map("account_id")
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([storeId, provider])
  @@index([tenantId, storeId])
  @@map("merchant_shipping_accounts")
}

model ShippingProfile {
  id                         String   @id @default(uuid())
  tenantId                   String   @map("tenant_id")
  storeId                    String   @map("store_id")
  name                       String
  flatRatePaise              Int      @default(0) @map("flat_rate_paise")
  freeShippingThresholdPaise Int?     @map("free_shipping_threshold_paise")
  isDefault                  Boolean  @default(true) @map("is_default")
  createdAt                  DateTime @default(now()) @map("created_at")
  updatedAt                  DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store  Store  @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([tenantId, storeId])
  @@map("shipping_profiles")
}

model Shipment {
  id                String            @id @default(uuid())
  tenantId          String            @map("tenant_id")
  storeId           String            @map("store_id")
  orderId           String            @map("order_id")
  provider          String            @default("MOCK")
  awbNumber         String?           @unique @map("awb_number")
  courierName       String?           @map("courier_name")
  trackingUrl       String?           @map("tracking_url")
  status            ShipmentStatus    @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  labelUrl          String?           @map("label_url")
  manifestUrl       String?           @map("manifest_url")
  weightKg          Float?            @map("weight_kg")
  lengthCm          Float?            @map("length_cm")
  widthCm           Float?            @map("width_cm")
  heightCm          Float?            @map("height_cm")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  order  Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  events ShipmentEvent[]

  @@index([tenantId, storeId, status])
  @@map("shipments")
}

model ShipmentEvent {
  id             String    @id @default(uuid())
  shipmentId     String    @map("shipment_id")
  status         String
  location       String?
  description    String?
  eventTimestamp DateTime? @map("event_timestamp")
  createdAt      DateTime  @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}

// ==============================================================================
// B2B & ENQUIRIES
// ==============================================================================

model Enquiry {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  storeId              String        @map("store_id")
  productId            String?       @map("product_id")
  customerName         String        @map("customer_name")
  customerPhone        String        @map("customer_phone")
  customerEmail        String?       @map("customer_email")
  companyName          String?       @map("company_name")
  message              String
  requestedQuantity    Int           @default(1) @map("requested_quantity")
  status               EnquiryStatus @default(NEW)
  quotationAmountPaise Int?          @map("quotation_amount_paise")
  notes                String?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tenant  Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store   Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([tenantId, storeId, status])
  @@map("enquiries")
}

// ==============================================================================
// AUDIT, OUTBOX & RELIABILITY
// ==============================================================================

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  actorType  String   @default("USER") @map("actor_type") // USER, SYSTEM, ADMIN
  tenantId   String?  @map("tenant_id")
  storeId    String?  @map("store_id")
  action     String   // e.g. STORE_SUSPENDED, PRODUCT_CREATED, REFUND_ISSUED
  entityType String   @map("entity_type") // Store, Product, Order, etc.
  entityId   String?  @map("entity_id")
  metadata   Json?    // Safe metadata (strictly no secrets/passwords)
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id                 String            @id @default(uuid())
  key                String            @unique
  tenantId           String?           @map("tenant_id")
  storeId            String?           @map("store_id")
  route              String
  requestHash        String            @map("request_hash")
  status             IdempotencyStatus @default(IN_PROGRESS)
  responseStatusCode Int?              @map("response_status_code")
  responseBody       Json?             @map("response_body")
  expiresAt          DateTime          @map("expires_at")
  createdAt          DateTime          @default(now()) @map("created_at")

  @@index([key, status, expiresAt])
  @@map("idempotency_keys")
}

model OutboxEvent {
  id          String       @id @default(uuid())
  tenantId    String?      @map("tenant_id")
  storeId     String?      @map("store_id")
  eventType   String       @map("event_type")
  payload     Json
  status      OutboxStatus @default(PENDING)
  retryCount  Int          @default(0) @map("retry_count")
  maxRetries  Int          @default(5) @map("max_retries")
  lastError   String?      @map("last_error")
  nextRetryAt DateTime?    @map("next_retry_at")
  processedAt DateTime?    @map("processed_at")
  createdAt   DateTime     @default(now()) @map("created_at")

  @@index([status, nextRetryAt])
  @@map("outbox_events")
}

// ==============================================================================
// PRIVACY & DPDPA CONTROLS
// ==============================================================================

model ConsentRecord {
  id            String         @id @default(uuid())
  tenantId      String         @map("tenant_id")
  storeId       String         @map("store_id")
  customerId    String?        @map("customer_id")
  phone         String
  purpose       ConsentPurpose
  policyVersion String         @default("v1.0") @map("policy_version")
  ipAddress     String?        @map("ip_address")
  userAgent     String?        @map("user_agent")
  consentedAt   DateTime       @default(now()) @map("consented_at")
  revokedAt     DateTime?      @map("revoked_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, phone, purpose])
  @@map("consent_records")
}

model DataSubjectRequest {
  id          String                   @id @default(uuid())
  tenantId    String                   @map("tenant_id")
  phone       String
  email       String?
  requestType DataSubjectRequestType   @map("request_type")
  status      DataSubjectRequestStatus @default(PENDING)
  reason      String?
  requestedAt DateTime                 @default(now()) @map("requested_at")
  fulfilledAt DateTime?                @map("fulfilled_at")
  metadata    Json?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("data_subject_requests")
}

// ==============================================================================
// PRODUCT REVIEWS & MODERATION
// ==============================================================================

model ProductReview {
  id                String    @id @default(uuid())
  storeId           String    @map("store_id")
  productId         String    @map("product_id")
  orderId           String    @map("order_id")
  orderItemId       String    @map("order_item_id")
  reviewerName      String    @map("reviewer_name")
  rating            Int
  title             String?
  body              String
  verifiedPurchase  Boolean   @default(true) @map("verified_purchase")
  status            String    @default("ACTIVE") // ACTIVE, REMOVED
  moderatedAt       DateTime? @map("moderated_at")
  moderatedBy       String?   @map("moderated_by")
  moderationReason  String?   @map("moderation_reason")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  reports   ReviewReport[]

  @@unique([orderItemId, productId])
  @@index([productId, status])
  @@index([storeId, status])
  @@index([orderId])
  @@map("product_reviews")
}

enum ReviewReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

model ReviewReport {
  id           String             @id @default(uuid())
  reviewId     String             @map("review_id")
  reportedById String?            @map("reported_by_id")
  reason       String
  merchantNote String?            @map("merchant_note")
  status       ReviewReportStatus @default(PENDING)
  adminNote    String?            @map("admin_note")
  resolvedById String?            @map("resolved_by_id")
  resolvedAt   DateTime?          @map("resolved_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  review       ProductReview      @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@index([reviewId, createdAt])
  @@index([status, createdAt])
  // The migration adds a partial unique index allowing only one open report per review.
  @@map("review_reports")
}

// ==============================================================================
// BUSINESS VERIFICATION & MERCHANT DOCUMENTS
// ==============================================================================

enum MerchantDocumentType {
  PAN
  BUSINESS_REGISTRATION
  OWNER_ID
  UDYAM
  GST_CERTIFICATE
  OTHER
}

enum MerchantDocumentStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  REUPLOAD_REQUIRED
}

model MerchantDocument {
  id                   String                 @id @default(uuid())
  tenantId             String                 @map("tenant_id")
  type                 MerchantDocumentType
  documentNumberMasked String?                @map("document_number_masked")
  storageKey           String                 @map("storage_key")
  originalFilename     String                 @map("original_filename")
  mimeType             String                 @map("mime_type")
  fileSizeBytes        Int                    @map("file_size_bytes")
  status               MerchantDocumentStatus @default(PENDING_REVIEW)
  isCurrent            Boolean                @default(true) @map("is_current")
  rejectionReason      String?                @map("rejection_reason")
  adminNote            String?                @map("admin_note")
  uploadedAt           DateTime               @default(now()) @map("uploaded_at")
  reviewedAt           DateTime?              @map("reviewed_at")
  reviewedById         String?                @map("reviewed_by_id")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([tenantId, status])
  @@map("merchant_documents")
}

// ==============================================================================
// PLATFORM SETTINGS & SUB ADMIN INVITES
// ==============================================================================

model PlatformSetting {
  key         String   @id
  value       Json
  category    String   @default("general")
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id")

  @@map("platform_settings")
}

model AdminInvite {
  id          String    @id @default(uuid())
  email       String    @unique
  fullName    String    @map("full_name")
  phone       String?
  tokenHash   String    @unique @map("token_hash")
  permissions Json      @default("[]")
  invitedById String    @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("admin_invites")
}
